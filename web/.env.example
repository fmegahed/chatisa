# ChatISA server configuration — NAMES ONLY, never commit real values.
# Copy to .env.local and fill in. All provider keys are optional: absent keys
# reduce the model catalog (the affected models are hidden from students).

# --- LLM providers ---
# Each key you set enables that provider's models. Models whose provider has
# no key are hidden from the model picker rather than failing at send time.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=
# HF_TOKEN enables the eight open-weight models (DeepSeek, Qwen, GPT-OSS,
# Llama 4). These exist to show students open-source alternatives, so leaving
# this unset removes that part of the teaching value.
# Create a read-only token at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Ask Anything literature sources (optional, but read the note) ---
# Ask Anything searches arXiv, Semantic Scholar, and OpenAlex in parallel.
# arXiv and OpenAlex need no credentials. Semantic Scholar's KEYLESS pool is
# shared across every anonymous caller on the internet and answers 429 to
# nearly every request, so leaving this blank means students see
# "Unavailable this time: Semantic Scholar." on essentially every search and
# lose its citation counts, reference counts, and tldr summaries.
# Request a free academic key at:
#   https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
# A contact address puts us in OpenAlex's faster, more reliable pool. Use a
# role address, not a personal one; it is sent with every OpenAlex request.
OPENALEX_MAILTO=

# --- Auth (required in production) ---
# Generate AUTH_SECRET with: npx auth secret   (>= 32 chars)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Base URL of THIS deployment:
#   local dev:  http://localhost:3000
#   production: https://chatisa.fsb.miamioh.edu
AUTH_URL=http://localhost:3000
# AUTH_TEST_MODE=1 enables a fake login for automated tests.
# It is refused in production builds. Leave unset normally.
#AUTH_TEST_MODE=0

# --- HTTPS production wrapper (Slice 10) ---
SSL_CERT_FILE_PATH=
SSL_KEY_FILE_PATH=
